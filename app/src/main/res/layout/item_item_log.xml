<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDirectionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:background="@drawable/bg_status_inside"
                tools:text="ورود"
                tools:textColor="@color/status_green" />

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/concrete_900"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="روغن هیدرولیک" />

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/concrete_500"
                android:textSize="11sp"
                tools:text="1404/05/17 — 10:24" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/concrete_700"
            android:textSize="13sp"
            tools:text="فروشگاه: صنعتی البرز — خریدار: رضایی — واحد: تعمیرگاه — فاکتور: ۱۲۳۴" />

        <TextView
            android:id="@+id/tvReturnStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_status_inside"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/status_green"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="برگشت داده شد" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarkReturned"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_gravity="start"
            android:text="@string/item_log_mark_returned"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
